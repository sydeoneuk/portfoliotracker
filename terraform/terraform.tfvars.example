# Copy this file to terraform.tfvars and fill in the values.
# terraform.tfvars is gitignored — never commit it.

aws_region      = "eu-west-2"
instance_type   = "t3.small"
domain_name     = "t212.example.com"
route53_zone_id = "Z1234567890ABCDEF"   # from Route 53 console
app_repo_url    = "https://github.com/YOUR_ORG/YOUR_REPO.git"

# Paste the contents of your public key (e.g. ~/.ssh/id_ed25519.pub)
ssh_public_key = "ssh-ed25519 AAAA... user@host"

# Restrict SSH to your own IP — find it at https://checkip.amazonaws.com
allowed_ssh_cidrs = ["YOUR.IP.ADDRESS/32"]
