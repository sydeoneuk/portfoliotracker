# PostgreSQL
POSTGRES_DB=trading212
POSTGRES_USER=trading212
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Session security
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Encryption key for stored Trading 212 credentials
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# OAuth - configure at least one provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Base URL used for OAuth callback URIs
APP_BASE_URL=http://localhost:8001

# Optional security toggle for production
HTTPS_ONLY=false

# Optional enrichment APIs
FMP_API_KEY=
OPENFIGI_API_KEY=
ANTHROPIC_API_KEY=

# Optional admin users - comma-separated email addresses
ADMIN_EMAILS=

# Production deployment
DOMAIN_NAME=

# Legacy single-user sync script credentials (not used by the web app)
T212_API_KEY=
T212_API_SECRET=
T212_ISA_API_KEY=
T212_ISA_API_SECRET=
T212_BASE_URL=https://live.trading212.com/api/v0
