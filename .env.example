# Trading 212 API
T212_API_KEY=your_api_key_here
T212_API_SECRET=your_api_secret_here
T212_BASE_URL=https://live.trading212.com/api/v0
# Use https://demo.trading212.com/api/v0 for paper trading

# Financial Modeling Prep (optional) — adds pay dates + upcoming dividend calendar
# Free tier: 250 req/day  https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=

# Anthropic Claude (optional) — fallback description enricher for instruments
# yfinance → FMP → Claude → synthesised metadata (in order of preference)
# Get a key: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Application
DOMAIN_NAME=t212.sydeone.co.uk
# APP_BASE_URL is constructed from DOMAIN_NAME in docker-compose.prod.yml
# For local development set it directly: APP_BASE_URL=http://localhost:8001

# PostgreSQL
POSTGRES_DB=trading212
POSTGRES_USER=trading212
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
